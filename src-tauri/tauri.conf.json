{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noteflow",
  "version": "1.2.0",
  "identifier": "com.noteflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoteFlow",
        "width": 1240,
        "height": 820,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "category": "Utility",
    "shortDescription": "Offline-first desktop notes",
    "longDescription": "NoteFlow is a fast, offline-first notes application for the Linux desktop.",
    "linux": {
      "deb": {
        "desktopTemplate": "../assets/noteflow.desktop"
      }
    }
  }
}

